# Environment variables
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC="rti_topic"
KAFKA_GROUP_ID="rti_group"

# MEERA API
FETCH_RTI_QUERY_API_URL="http://localhost:8000/api/fetch_rti_query"

# LLM Configuration
OPENAI_API_KEY="your_api_key_here"
OPENAI_API_BASE="your_api_base_url_here"
LLM_TEMPERATURE="0.0"

# BERT Configuration
BERT_MODEL_PATH="your_bert_model_path_here"

# Mail Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
INSERT_MAIL_RECORD_API_URL="http://localhost:8000/api/insert_mail_record"

# Workflow Endpoints
